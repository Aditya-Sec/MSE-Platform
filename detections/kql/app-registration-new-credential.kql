// ATT&CK: T1098.001 — Account Manipulation: Additional Cloud Credentials
// Tactic: Persistence
// Data source: AuditLogs (Azure AD)
//
// Detects a new client secret or certificate being added to an existing
// app registration — a quiet, durable persistence technique, since app
// registrations are frequently over-permissioned and under-monitored
// compared to user accounts, and a new credential added to one survives a
// full password reset of every human account in the tenant.

AuditLogs
| where TimeGenerated > ago(24h)
| where OperationName in ("Update application", "Update service principal")
| where Category == "ApplicationManagement"
| mv-expand TargetResource = TargetResources
| mv-expand ModifiedProperty = TargetResource.modifiedProperties
| extend PropertyName = tostring(ModifiedProperty.displayName)
| where PropertyName in ("KeyDescription", "AppAddOwner", "CertificateAndSecretsManagement")
| extend AppName = tostring(TargetResource.displayName),
         InitiatedByUser = tostring(InitiatedBy.user.userPrincipalName)
| project TimeGenerated, InitiatedByUser, AppName, PropertyName
| extend AlertSeverity = "Medium"
