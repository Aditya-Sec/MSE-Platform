// ATT&CK: T1110.003 — Brute Force: Password Spraying
// Tactic: Credential Access
// Data source: SigninLogs
//
// Detects the specific shape of password spraying: many DISTINCT usernames
// failing sign-in from the same source IP in a short window, each only
// tried once or twice — different from classic brute force (one account,
// many attempts), which is why a single-account failed-login-count rule
// would miss this pattern entirely.

SigninLogs
| where TimeGenerated > ago(1h)
| where ResultType in ("50126", "50053")  // invalid credentials / account locked
| summarize DistinctUsers = dcount(UserPrincipalName),
            AttemptsPerUser = count() / dcount(UserPrincipalName),
            TargetedUsers = make_set(UserPrincipalName, 20)
          by IPAddress, bin(TimeGenerated, 30m)
| where DistinctUsers >= 10 and AttemptsPerUser <= 3  // many users, few attempts each = spray, not brute force
| extend AlertSeverity = "High"
| project TimeGenerated, IPAddress, DistinctUsers, AttemptsPerUser, TargetedUsers, AlertSeverity
